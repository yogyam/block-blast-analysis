{
  "name": "@blockblast/capture",
  "version": "0.1.0",
  "private": true,
  "description": "Emulator driver for the real Block Blast! game: adb screenshots, board and tray readers, calibrated drag-and-drop, and a player loop that logs real dealt hands.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "play": "node --experimental-strip-types --no-warnings src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@blockblast/engine": "workspace:*",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  }
}
