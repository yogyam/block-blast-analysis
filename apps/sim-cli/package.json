{
  "name": "@blockblast/sim-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Simulate Block Blast! games for a (generator, agent) pair and write one JSONL row per dealt hand in the 06-methods.md §10 schema; summarise such files.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "blockblast-sim": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sim": "node --experimental-strip-types --no-warnings src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@blockblast/engine": "workspace:*",
    "@blockblast/generators": "workspace:*",
    "@blockblast/analysis": "workspace:*"
  }
}
